{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-spine.dev/schemas/registry.schema.json",
  "title": "spec-spine registry (spec-as-source view)",
  "description": "The deterministic output of `spec-spine compile`. Schema version is library-owned (see spec-spine-types::REGISTRY_SCHEMA_VERSION). v1 validates the structural envelope and the required core fields; the typed-edge payload is intentionally permissive (additionalProperties) so an additive minor can extend it.",
  "type": "object",
  "required": ["specVersion", "build", "specs", "validation"],
  "additionalProperties": false,
  "properties": {
    "specVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "build": {
      "type": "object",
      "required": ["compilerId", "compilerVersion", "inputRoot", "contentHash"],
      "additionalProperties": false,
      "properties": {
        "compilerId": { "type": "string", "minLength": 1 },
        "compilerVersion": { "type": "string", "minLength": 1 },
        "inputRoot": { "type": "string" },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "specs": {
      "type": "array",
      "items": { "$ref": "#/$defs/specRecord" }
    },
    "validation": {
      "type": "object",
      "required": ["passed", "violations"],
      "additionalProperties": false,
      "properties": {
        "passed": { "type": "boolean" },
        "violations": {
          "type": "array",
          "items": { "$ref": "#/$defs/violation" }
        }
      }
    }
  },
  "$defs": {
    "specRecord": {
      "type": "object",
      "required": ["id", "title", "status", "created", "summary", "specPath"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "approved", "superseded", "retired"] },
        "created": { "type": "string" },
        "summary": { "type": "string" },
        "specPath": { "type": "string", "pattern": "^.+/spec\\.md$" },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "implementation": {
          "enum": ["pending", "in-progress", "complete", "n-a", "deferred"]
        },
        "extraFrontmatter": {
          "type": "object",
          "description": "Adopter frontmatter transported by the compiler. Declared keys (frontmatter.extra_known_keys) carry any JSON value (spec 012; first shipped in specVersion 0.2.0); undeclared keys are scalars or string arrays."
        },
        "obligations": {
          "type": "array",
          "description": "Declared constraints (spec 106; first shipped in specVersion 1.4.0).",
          "items": {
            "type": "object",
            "required": ["id", "kind", "text", "anchor"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(-[A-Za-z0-9]+)*$" },
              "kind": { "enum": ["requirement", "invariant", "verification"] },
              "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "anchor": { "type": "string", "minLength": 1 },
              "inputs": { "type": "array", "items": { "type": "string" } },
              "withdrawn": { "const": true }
            }
          }
        },
        "sectionDigests": {
          "type": "object",
          "description": "Every body section's anchor mapped to its digest (spec 106; first shipped in specVersion 1.4.0).",
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "impacts": {
          "type": "array",
          "description": "Declared relations to other specs' obligations (spec 109; first shipped in specVersion 1.5.0). `obligation` is normalized to its full qualified form.",
          "items": {
            "type": "object",
            "required": ["obligation", "nature"],
            "additionalProperties": false,
            "properties": {
              "obligation": { "type": "string", "pattern": "^[^\\s#]+#[^\\s#]+$" },
              "nature": { "enum": ["refines", "extends", "supersedes", "informs"] },
              "successor": { "type": "string", "minLength": 1 },
              "note": { "type": "string" }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "description": "Declared, unresolved disagreements with other specs' obligations (spec 109; first shipped in specVersion 1.5.0). `obligation` is normalized to its full qualified form.",
          "items": {
            "type": "object",
            "required": ["obligation", "reason", "resolution"],
            "additionalProperties": false,
            "properties": {
              "obligation": { "type": "string", "pattern": "^[^\\s#]+#[^\\s#]+$" },
              "reason": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "resolution": { "enum": ["deliberate", "unresolved", "pending"] },
              "settledBy": { "type": "string", "minLength": 1 }
            }
          }
        },
        "interfaceReferences": {
          "type": "array",
          "description": "Cross-corpus interface references, carried verbatim (spec 110; first shipped in specVersion 1.6.0).",
          "items": {
            "type": "object",
            "required": ["corpus", "spec", "digest", "obtained"],
            "additionalProperties": false,
            "properties": {
              "corpus": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
              "spec": { "type": "string", "pattern": "^[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$" },
              "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "sections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["anchor", "digest"],
                  "additionalProperties": false,
                  "properties": {
                    "anchor": { "type": "string", "minLength": 1 },
                    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                  }
                }
              },
              "obtained": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "rationale": { "type": "string" }
            }
          }
        }
      }
    },
    "violation": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z]-[0-9]{3}$" },
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string" }
      }
    }
  }
}
