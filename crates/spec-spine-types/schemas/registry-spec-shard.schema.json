{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-spine.dev/schemas/registry-spec-shard.schema.json",
  "title": "spec-spine registry, per-spec shard (spec 022)",
  "description": "One file per spec under <derived>/spec-registry/by-spec/<id>.json. The deterministic, conflict-free committed form of one spec's compiled record. The aggregate registry (validation, content hash) is recomputed on read from the shard set and is not committed. The record payload is intentionally permissive (additionalProperties) so an additive minor can extend it, matching registry.schema.json.",
  "type": "object",
  "required": ["specVersion", "shardHash", "record"],
  "additionalProperties": false,
  "properties": {
    "specVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "shardHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "record": { "$ref": "#/$defs/specRecord" },
    "localViolations": {
      "type": "array",
      "items": { "$ref": "#/$defs/violation" }
    }
  },
  "$defs": {
    "specRecord": {
      "type": "object",
      "required": ["id", "title", "status", "created", "summary", "specPath"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "approved", "superseded", "retired"] },
        "created": { "type": "string" },
        "summary": { "type": "string" },
        "specPath": { "type": "string", "pattern": "^.+/spec\\.md$" },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "implementation": {
          "enum": ["pending", "in-progress", "complete", "n-a", "deferred"]
        },
        "extraFrontmatter": {
          "type": "object",
          "description": "Adopter frontmatter transported by the compiler (spec 012)."
        },
        "obligations": {
          "type": "array",
          "description": "Declared constraints (spec 106; first shipped in specVersion 1.4.0).",
          "items": {
            "type": "object",
            "required": ["id", "kind", "text", "anchor"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(-[A-Za-z0-9]+)*$" },
              "kind": { "enum": ["requirement", "invariant", "verification"] },
              "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "anchor": { "type": "string", "minLength": 1 },
              "inputs": { "type": "array", "items": { "type": "string" } },
              "withdrawn": { "const": true }
            }
          }
        },
        "sectionDigests": {
          "type": "object",
          "description": "Every body section's anchor mapped to its digest (spec 106; first shipped in specVersion 1.4.0).",
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "impacts": {
          "type": "array",
          "description": "Declared relations to other specs' obligations (spec 109; first shipped in specVersion 1.5.0). `obligation` is normalized to its full qualified form.",
          "items": {
            "type": "object",
            "required": ["obligation", "nature"],
            "additionalProperties": false,
            "properties": {
              "obligation": { "type": "string", "pattern": "^[^\\s#]+#[^\\s#]+$" },
              "nature": { "enum": ["refines", "extends", "supersedes", "informs"] },
              "successor": { "type": "string", "minLength": 1 },
              "note": { "type": "string" }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "description": "Declared, unresolved disagreements with other specs' obligations (spec 109; first shipped in specVersion 1.5.0). `obligation` is normalized to its full qualified form.",
          "items": {
            "type": "object",
            "required": ["obligation", "reason", "resolution"],
            "additionalProperties": false,
            "properties": {
              "obligation": { "type": "string", "pattern": "^[^\\s#]+#[^\\s#]+$" },
              "reason": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "resolution": { "enum": ["deliberate", "unresolved", "pending"] },
              "settledBy": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "violation": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z]-[0-9]{3}$" },
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string" }
      }
    }
  }
}
