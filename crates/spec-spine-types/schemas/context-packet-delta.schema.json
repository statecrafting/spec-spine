{
  "$defs": {
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "digest",
            "interface-unknown",
            "closure-changed",
            "unbound-manifest",
            "fallback"
          ]
        },
        "change": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "interface-changed",
                "changed",
                "removed",
                "newly-unresolved",
                "newly-omitted",
                "newly-available"
              ]
            }
          ]
        },
        "inputId": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/key"
            }
          ]
        },
        "manifestDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "requirement": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "required",
                "optional"
              ]
            }
          ]
        },
        "uses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "manifestDigest",
        "inputId",
        "requirement",
        "key",
        "change",
        "basis",
        "uses"
      ],
      "type": "object"
    },
    "candidates": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "const": "packet-members"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/candidate"
          },
          "type": "array"
        }
      },
      "required": [
        "coverage",
        "items"
      ],
      "type": "object"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "changed": {
          "minimum": 0,
          "type": "integer"
        },
        "interfaceChanged": {
          "minimum": 0,
          "type": "integer"
        },
        "newlyAvailable": {
          "minimum": 0,
          "type": "integer"
        },
        "newlyOmitted": {
          "minimum": 0,
          "type": "integer"
        },
        "newlyUnresolved": {
          "minimum": 0,
          "type": "integer"
        },
        "removed": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "interfaceChanged",
        "changed",
        "removed",
        "newlyUnresolved",
        "newlyOmitted",
        "newlyAvailable"
      ],
      "type": "object"
    },
    "delta": {
      "additionalProperties": false,
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/entry"
          },
          "type": "array"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "deltaDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "invalidationCandidates": {
          "$ref": "#/$defs/candidates"
        },
        "outcome": {
          "const": "delta"
        },
        "predecessor": {
          "additionalProperties": false,
          "properties": {
            "pageDigests": {
              "items": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "snapshot": {
              "$ref": "#/$defs/snapshot"
            }
          },
          "required": [
            "snapshot",
            "pageDigests"
          ],
          "type": "object"
        },
        "producer": {
          "additionalProperties": false,
          "properties": {
            "build": {
              "type": "string"
            },
            "package": {
              "const": "spec-spine"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "package",
            "version",
            "build"
          ],
          "type": "object"
        },
        "producerChanged": {
          "type": "boolean"
        },
        "requestDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "schemaVersion": {
          "type": "string"
        },
        "target": {
          "additionalProperties": false,
          "properties": {
            "closure": {
              "type": [
                "object",
                "null"
              ]
            },
            "pageDigests": {
              "items": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "pages": {
              "items": {
                "$ref": "#/$defs/layout"
              },
              "minItems": 1,
              "type": "array"
            },
            "snapshot": {
              "$ref": "#/$defs/snapshot"
            }
          },
          "required": [
            "snapshot",
            "pageDigests",
            "closure",
            "pages"
          ],
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "outcome",
        "producer",
        "producerChanged",
        "requestDigest",
        "predecessor",
        "target",
        "changes",
        "counts",
        "invalidationCandidates",
        "deltaDigest"
      ],
      "type": "object"
    },
    "entry": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "digest",
            "interface-unknown",
            "closure-changed",
            "unbound-manifest",
            "fallback"
          ]
        },
        "change": {
          "enum": [
            "interface-changed",
            "changed",
            "removed",
            "newly-unresolved",
            "newly-omitted",
            "newly-available"
          ]
        },
        "fields": {
          "items": {
            "enum": [
              "content",
              "span",
              "requirement",
              "origins"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "interface": {
          "$ref": "#/$defs/interface"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "priorInterface": {
          "$ref": "#/$defs/interface"
        },
        "priorItemDigest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          ]
        },
        "priorReason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "missing",
                "removed",
                "withdrawn",
                "unresolved",
                "ambiguous",
                "unsupported-selector",
                "unsupported-projection",
                "non-text",
                "oversized-member",
                "item-budget",
                "byte-budget"
              ]
            }
          ]
        },
        "priorState": {
          "enum": [
            "present",
            "omitted",
            "absent"
          ]
        },
        "reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "missing",
                "removed",
                "withdrawn",
                "unresolved",
                "ambiguous",
                "unsupported-selector",
                "unsupported-projection",
                "non-text",
                "oversized-member",
                "item-budget",
                "byte-budget"
              ]
            }
          ]
        },
        "record": {
          "description": "The complete target member, as a context-packet member.",
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "change",
        "basis",
        "priorState",
        "priorItemDigest",
        "priorReason",
        "reason",
        "fields",
        "priorInterface",
        "interface",
        "record"
      ],
      "type": "object"
    },
    "fallback": {
      "additionalProperties": false,
      "properties": {
        "deltaDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "invalidationCandidates": {
          "$ref": "#/$defs/candidates"
        },
        "outcome": {
          "const": "fallback"
        },
        "predecessor": {
          "additionalProperties": false,
          "properties": {
            "pageDigests": {
              "items": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "pageDigests"
          ],
          "type": "object"
        },
        "reason": {
          "enum": [
            "predecessor-unverifiable",
            "predecessor-incomplete",
            "repository-changed",
            "schema-version-changed",
            "budget-changed",
            "request-changed",
            "delta-too-large"
          ]
        },
        "requestDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "schemaVersion": {
          "type": "string"
        },
        "target": {
          "additionalProperties": false,
          "properties": {
            "snapshot": {
              "$ref": "#/$defs/snapshot"
            }
          },
          "required": [
            "snapshot"
          ],
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "outcome",
        "reason",
        "requestDigest",
        "predecessor",
        "target",
        "invalidationCandidates",
        "deltaDigest"
      ],
      "type": "object"
    },
    "interface": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "enum": [
                "spec-content-hash",
                "section-digest",
                "obligation-digest",
                "symbol-signature",
                "unavailable",
                "not-applicable"
              ]
            }
          },
          "required": [
            "kind",
            "digest"
          ],
          "type": "object"
        }
      ]
    },
    "key": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "minLength": 1,
          "type": "string"
        },
        "projection": {
          "enum": [
            "full",
            "declaration",
            "signature",
            "documentation",
            "body"
          ]
        }
      },
      "required": [
        "identity",
        "projection"
      ],
      "type": "object"
    },
    "layout": {
      "additionalProperties": false,
      "properties": {
        "envelope": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "members"
                ]
              },
              {
                "required": [
                  "omissions"
                ]
              },
              {
                "required": [
                  "closure"
                ]
              }
            ]
          },
          "required": [
            "packetDigest"
          ],
          "type": "object"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/key"
          },
          "type": "array"
        },
        "omissions": {
          "items": {
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "envelope",
        "members",
        "omissions"
      ],
      "type": "object"
    },
    "request": {
      "additionalProperties": false,
      "properties": {
        "consumerSchemaVersion": {
          "type": "string"
        },
        "manifests": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "predecessorPages": {
          "items": {
            "type": "string"
          },
          "maxItems": 512,
          "minItems": 1,
          "type": "array"
        },
        "request": {
          "type": "object"
        }
      },
      "required": [
        "request",
        "predecessorPages",
        "consumerSchemaVersion"
      ],
      "type": "object"
    },
    "snapshot": {
      "additionalProperties": false,
      "properties": {
        "dirtyState": {
          "enum": [
            "clean-working-tree",
            "clean-export"
          ]
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "tree": {
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "revision",
        "tree",
        "dirtyState"
      ],
      "type": "object"
    }
  },
  "$id": "https://spec-spine.dev/schemas/context-packet-delta.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A delta from a caller's complete context-packet page set to the page set spec 159 assembles for the same request on a target snapshot, or an explicit full-packet fallback (spec 164). The root validates a delta or a fallback; $defs/request is the delta request. Carries no authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/delta"
    },
    {
      "$ref": "#/$defs/fallback"
    }
  ],
  "title": "spec-spine context-packet delta"
}
