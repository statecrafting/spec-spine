    "id": "160-documentation-manifest-and-freshness",
    "implementation": "pending",
    "intent": {
      "goal": "make declared documentation provenance and freshness deterministic",
      "nonGoals": [
        "narrative generation, semantic truth judgment, or documentation acceptance",
        "running generators, examples, tests, commands, or provider workflows",
        "evidence admission, wire-evidence semantics, or invalidation disposition"
      ]
    },
    "kind": "governance",
    "obligations": [
      {
        "anchor": "3-1-one-manifest-one-packet-and-generator-run",
        "id": "R-1",
        "kind": "requirement",
        "text": "A documentation manifest binds declared inputs, generator identity, outputs, regions, and examples to one repository-scoped packet."
      },
      {
        "anchor": "3-10-freshness-evaluation",
        "id": "R-2",
        "kind": "requirement",
        "text": "Freshness deterministically names every changed, missing, unresolved, unsupported, or unverified declared identity without emitting its content."
      },
      {
        "anchor": "3-13-ordering-limits-canonical-bytes-and-schema-evolution",
        "id": "R-3",
        "kind": "requirement",
        "text": "Manifest and freshness bytes, ordering, identities, digests, limits, and schema evolution are deterministic and versioned."
      },
      {
        "anchor": "3-16-authority-security-and-disclosure-boundary",
        "id": "I-1",
        "kind": "invariant",
        "text": "Manifest freshness never establishes narrative correctness, execution, evidence admission, acceptance, release, adoption, or authority."
      },
      {
        "anchor": "verification",
        "id": "V-1",
        "inputs": [
          "crates/spec-spine-core/tests/documentation_manifest.rs",
          "crates/spec-spine-cli/tests/documentation_manifest.rs"
        ],
        "kind": "verification",
        "text": "The implemented manifest contract is checked for identity binding, region integrity, canonical bytes, freshness findings, stale snapshots, containment, and lifecycle boundaries."
      }
    ],
