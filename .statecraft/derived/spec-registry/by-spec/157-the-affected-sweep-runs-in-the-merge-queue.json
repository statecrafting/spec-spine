    "id": "157-the-affected-sweep-runs-in-the-merge-queue",
    "implementation": "complete",
    "intent": {
      "goal": "Move the whole-corpus pre-merge acceptance run off the driving session and into the merge queue, without sweeping a change nobody has queued.",
      "nonGoals": [
        "Narrowing the engine-source selection rule.",
        "Replacing the post-merge and scheduled sweeps of specs 099 and 121."
      ]
    },
    "kind": "process",
    "obligations": [
      {
        "anchor": "3-1-the-sweep-is-a-merge-queue-check",
        "id": "R-1",
        "kind": "requirement",
        "text": "A queued change is merged only after every affected-acceptance shard reports a clean release verdict: no implemented or unreadable spec has a failed, not-declared or not-run release outcome; pending specs still run and remain reported but do not block."
      },
      {
        "anchor": "3-2-the-selection-is-sharded",
        "id": "R-2",
        "kind": "requirement",
        "text": "verify-sweep.sh --shard i/n runs exactly the i-th of n disjoint parts of its selection, and the n parts cover the selection once."
      },
      {
        "anchor": "3-3-the-session-step-retires",
        "id": "R-3",
        "kind": "requirement",
        "text": "No step requires a session to run the affected sweep locally or to record its counts in the pull request body."
      },
      {
        "anchor": "3-4-the-trust-boundary-holds",
        "id": "R-4",
        "kind": "requirement",
        "text": "The sweep never runs on a pull_request event."
      }
    ],
