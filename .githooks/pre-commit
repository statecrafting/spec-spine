#!/usr/bin/env sh
# Governed in the spec-spine repository by
# specs/094-one-gate-and-the-boundaries-it-holds/spec.md. Provenance
# only, never a claim header: the claim syntax would name a spec id that
# exists in no adopter's corpus, and would shadow one the adopter adds below
# it (spec 095).
#
# The commit boundary (spec 094). Every other hook the kit ships is bound to a
# Claude Code tool name, so it fires only when the session took that route. A
# commit is one command whatever wrote the bytes, which makes this the only
# guard in the kit that is a property of the change rather than of the actor.
#
# It REFUSES and never repairs (spec 093 3.1, spec 094 3.1). Regenerating and
# staging here would collapse "was never stale" and "was stale until the hook
# fixed it" into the same commit, and telling those apart is the whole content
# of `check`. The remedy is `make refresh`, run by the committer.
#
# Enable once per clone:  ./.githooks/enable-hooks.sh
# Bypass one commit:      git commit --no-verify

set -eu

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -d "$root/specs" ] || exit 0

refuse() {
  echo "[pre-commit] REFUSED: $1"
  echo "[pre-commit] fix: $2"
  echo '[pre-commit] bypass this one commit: git commit --no-verify'
  exit 1
}

# 0. The change itself is whole (spec 122). These need no spec-spine binary,
# so they run before it is resolved and hold on a machine without one.
#
# 0a. No unmerged index entry. `git add` after a conflicted merge clears the
# stages without looking at what was added, so this is the weaker half; 0b is
# the one that catches a resolved-by-staging conflict.
if [ -n "$(git -C "$root" ls-files -u 2>/dev/null)" ]; then
  git -C "$root" ls-files -u | cut -f2 | sort -u | sed 's/^/  /'
  refuse 'the index holds unmerged entries' 'resolve each path listed above, then stage it'
fi

# 0b. No conflict marker on an ADDED line. git's own detector, over the staged
# change only, so a marker already in history is never re-reported. A file
# that carries markers on purpose (a merge fixture) opts out by name with the
# git attribute `conflict-marker-size`, never by a pattern here.
markers=$(git -C "$root" diff --cached --check 2>/dev/null | grep 'leftover conflict marker' || true)
if [ -n "$markers" ]; then
  printf '%s\n' "$markers" | sed 's/^/  /'
  refuse 'the staged change adds merge conflict markers' 'resolve the conflict in each file listed above; an intentional fixture sets the conflict-marker-size attribute in .gitattributes'
fi

# 0c. Formatting, when the change stages Rust. The one required check cheap
# enough for every commit; clippy and the tests stay the gate's (spec 094).
# A manifest probe, then a tool probe, as the Makefile guards do.
if [ -f "$root/Cargo.toml" ] && git -C "$root" diff --cached --name-only --diff-filter=ACMR | grep -q '\.rs$'; then
  if command -v cargo >/dev/null 2>&1; then
    if ! fmt_out=$(cd "$root" && cargo fmt --all --check 2>&1); then
      printf '%s\n' "$fmt_out" | head -40
      refuse 'cargo fmt --all --check failed' 'cargo fmt --all, then stage the result'
    fi
  else
    echo '[pre-commit] cargo absent, formatting check skipped (spec 122)'
  fi
fi

# Spec 093's resolution order: the explicit override, then the binary this
# repository builds, then PATH. A repository that builds its own must be
# governed by the one it builds.
spec_spine_bin() {
  if [ -n "${SPEC_SPINE_BIN:-}" ] && [ -x "${SPEC_SPINE_BIN}" ]; then echo "${SPEC_SPINE_BIN}"; return 0; fi
  if [ -x "$1/target/release/spec-spine" ]; then echo "$1/target/release/spec-spine"; return 0; fi
  command -v spec-spine 2>/dev/null
}

# Spec 123: an in-tree build older than the source it is built from was built
# from an earlier revision, and its verdict is that revision's reading of this
# corpus. Prints the first source path newer than the binary, or nothing. Only
# the repository's own build has a source here to compare against.
spec_spine_reader_predates() {
  [ "$1" = "$2/target/release/spec-spine" ] || return 0
  n=$(find "$2/Cargo.toml" "$2/Cargo.lock" "$2/crates" -type f -newer "$1" 2>/dev/null | head -1)
  [ -n "$n" ] && printf '%s\n' "${n#"$2"/}"
  return 0
}

sc=$(spec_spine_bin "$root") || sc=''
if [ -z "$sc" ]; then
  echo '[pre-commit] spec-spine absent, freshness check skipped (spec 093 3.5)'
  exit 0
fi

# 1. Freshness. `check` reads both committed trees and never writes (spec 062),
# which is the property that lets a hook call it at all.
code=0
out=$("$sc" --repo "$root" check 2>&1) || code=$?
# Spec 123: a refusal names the executable that made it, and says when that is
# an in-tree build older than this checkout's source. Asked only off the happy
# path. The reader's own report is printed unchanged either way.
if [ "$code" != 0 ]; then
  rd="$sc ($("$sc" --version 2>/dev/null || echo 'no answer to --version'))"
  old=$(spec_spine_reader_predates "$sc" "$root")
  if [ -n "$old" ]; then
    echo "$out"
    refuse "the freshness read was made by $rd, which is older than this checkout's source ($old is newer); its verdict is an earlier revision's reading, not this tree's" 'cargo build --release --locked -p spec-spine-cli, then commit again'
  fi
fi
case "$code" in
  0) ;;
  2) echo "$out"
     refuse "a committed shard tree is stale, as read by $rd" 'make refresh, then stage the regenerated shards' ;;
  1) echo "$out"
     refuse "the corpus does not validate, as read by $rd" 'resolve the violations printed above, or confirm the reader is the one this corpus needs' ;;
  3) echo "$out"
     refuse "the freshness read could not be performed by $rd" 'read the error above; a read that did not answer is not a pass' ;;
  *) echo "$out"
     refuse "unknown exit code $code from the freshness read" 'confirm the binary with spec-spine --version' ;;
esac

# 2. Staged completeness. A working tree that compiles clean still lands stale
# when the regenerated shards sit outside the index.
if ! command -v jq >/dev/null 2>&1; then
  echo '[pre-commit] jq missing, staged-completeness check skipped'
  exit 0
fi

# The derived directory is a typed read of the tool's own answer, never a
# hardcoded path and never a hand-parse of spec-spine.toml.
derived=$("$sc" --repo "$root" config show --json 2>/dev/null | jq -r '.layout.derived_dir // empty' 2>/dev/null) || derived=''
if [ -z "$derived" ]; then
  echo '[pre-commit] derived_dir not reported, staged-completeness check skipped'
  exit 0
fi

loose=$(
  { git -C "$root" diff --name-only -- "$derived" 2>/dev/null || true
    git -C "$root" ls-files --others --exclude-standard -- "$derived" 2>/dev/null || true
  } | sed '/^$/d'
)
if [ -n "$loose" ]; then
  printf '%s\n' "$loose" | sed 's/^/  /'
  refuse 'regenerated derived files are not in this commit' 'stage the files listed above, or revert the edit that regenerated them'
fi

exit 0
